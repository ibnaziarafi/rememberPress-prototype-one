{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "/api/index/uploads/:path*"
    }
  ]
}
